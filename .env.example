# SC Chatbot — Root .env.example
# Copy to .env and adjust values as needed.
# Used by docker compose to set environment variables for all services.

# ──────────────────────────────────────────────────────────────
# LLM Provider (choose one)
# ──────────────────────────────────────────────────────────────
# LLM_PROVIDER=azure|openai
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# OpenAI / OpenAI-compatible (Ollama, Together, vLLM, OpenRouter)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ──────────────────────────────────────────────────────────────
# Embeddings
# ──────────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER=huggingface|openai|azure
EMBEDDING_PROVIDER=huggingface
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ──────────────────────────────────────────────────────────────
# Storage Backend
# ──────────────────────────────────────────────────────────────
# STORAGE_BACKEND=tinydb (default, no infra) or mongo
STORAGE_BACKEND=tinydb

# Only used when STORAGE_BACKEND=mongo (enable with: docker compose --profile mongo up)
MONGO_URI=mongodb://mongo:27017/scchatbot

# ──────────────────────────────────────────────────────────────
# Internal API Key (shared between chatbot-api ↔ client-server)
# ──────────────────────────────────────────────────────────────
INTERNAL_API_KEY=dev-key-change-me

# ──────────────────────────────────────────────────────────────
# Telegram Bot (polling worker)
# ──────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_TENANT=demo-beauty

# ──────────────────────────────────────────────────────────────
# Web Admin (JWT auth)
# ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
JWT_EXPIRES_MIN=60

# ──────────────────────────────────────────────────────────────
# Client Server (mock business API)
# ──────────────────────────────────────────────────────────────
# Port for client-server (default 8001)
CLIENT_SERVER_PORT=8001

# ──────────────────────────────────────────────────────────────
# Chatbot API
# ──────────────────────────────────────────────────────────────
# Default tenant if none specified
DEFAULT_TENANT=demo-beauty
DATA_DIR=./data