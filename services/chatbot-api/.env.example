# Choose provider: "azure" or "openai"
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- OpenAI / OpenAI-compatible (Ollama, Together, vLLM...) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Embeddings: "huggingface" (local, default), "openai", or "azure" ---
EMBEDDING_PROVIDER=huggingface
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Storage ---
DATA_DIR=./data
DEFAULT_TENANT=demo-beauty

# --- Telegram bot (polling worker) ---
# Tạo bot qua @BotFather trên Telegram và paste token vào đây.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_TENANT=demo-beauty

# --- client-server (mock business API) ---
# Phải khớp INTERNAL_API_KEY trong services/client-server/.env
CLIENT_SERVER_URL=http://localhost:8001
INTERNAL_API_KEY=dev-key-change-me

# --- web-admin (JWT login) ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# JWT expiration in minutes (spec: 60)
JWT_EXPIRES_MIN=60

# --- Chat history storage ---
# "tinydb" = local JSON file (default, không cần MongoDB)
# "mongo"  = MongoDB (yêu cầu MONGO_URI hợp lệ + MongoDB đang chạy)
STORAGE_BACKEND=tinydb

# Chỉ dùng khi STORAGE_BACKEND=mongo
MONGO_URI=mongodb://localhost:27017/scchatbot
